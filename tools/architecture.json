{
  "schema_version": 1,
  "packages": {
    "kyberia-domain": {"layer": "domain", "external_dependencies": ["serde", "serde_json", "sha2"]},
    "kyberia-spatial-analysis": {"layer": "numerical", "external_dependencies": ["serde"]},
    "kyberia-survey": {"layer": "application", "external_dependencies": ["serde"]},
    "kyberia-kismet-adapter": {"layer": "adapter", "external_dependencies": ["rusqlite", "sha2", "tempfile"]},
    "kyberia-packet-import": {"layer": "adapter", "external_dependencies": ["pcap-parser", "sha2"]},
    "kyberia-project-store": {"layer": "adapter", "external_dependencies": ["rusqlite", "serde", "serde_json", "sha2", "tempfile"]},
    "kyberia-capture-adapter": {"layer": "adapter", "external_dependencies": ["base64", "time", "serde", "serde_json", "sha2"]},
    "kyberia-cli": {"layer": "composition", "external_dependencies": ["serde_json", "uuid"]}
  },
  "allowed_internal_layers": {
    "domain": ["domain"],
    "numerical": ["domain", "numerical"],
    "application": ["domain", "numerical", "application"],
    "adapter": ["domain", "numerical", "application"],
    "composition": ["domain", "numerical", "application", "adapter", "composition"]
  }
}
