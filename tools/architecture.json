{
  "schema_version": 1,
  "packages": {
    "kyberia-domain": {"layer": "domain", "external_dependencies": ["serde"]},
    "kyberia-project-store": {"layer": "adapter", "external_dependencies": ["rusqlite", "serde", "serde_json", "sha2", "tempfile"]},
    "kyberia-cli": {"layer": "composition", "external_dependencies": ["serde_json", "uuid"]}
  },
  "allowed_internal_layers": {
    "domain": ["domain"],
    "numerical": ["domain", "numerical"],
    "application": ["domain", "numerical", "application"],
    "adapter": ["domain", "numerical", "application"],
    "composition": ["domain", "numerical", "application", "adapter", "composition"]
  }
}
